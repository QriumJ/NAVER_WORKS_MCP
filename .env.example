# Local by default. Set MCP_TRANSPORT=http to expose Streamable HTTP on MCP_PORT.
# For Docker/remote HTTP, use MCP_HOST=0.0.0.0, a 32+ character
# MCP_SHARED_SECRET, and a TLS-authenticated reverse proxy for external access.
MCP_TRANSPORT=stdio
MCP_PORT=8787
MCP_HOST=127.0.0.1
MCP_SHARED_SECRET=
# Optional comma-separated Host/Origin allowlist for a TLS-authenticated reverse proxy.
# Example: MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.example.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# NAVER WORKS API
NAVER_WORKS_API_BASE=https://www.worksapis.com/v1.0
# This MVP expects a pre-issued bearer token. OAuth code exchange/refresh and
# Service Account JWT signing should be supplied by an external secret/token provider.
NAVER_WORKS_ACCESS_TOKEN=
NAVER_WORKS_AUTH_MODE=user_oauth
NAVER_WORKS_USER_ID=
NAVER_WORKS_MOCK=false

# Enforced before a live API call. Keep the list narrower than the Developer Console scopes.
NAVER_WORKS_ENFORCE_SCOPES=true
NAVER_WORKS_SCOPES=calendar.read,contact.read,directory.read,user.profile.read
