# Local by default. Set MCP_TRANSPORT=http to expose Streamable HTTP on MCP_PORT.
# For Docker/remote HTTP, use MCP_HOST=0.0.0.0, a 32+ character
# MCP_SHARED_SECRET, and a TLS-authenticated reverse proxy for external access.
MCP_TRANSPORT=stdio
MCP_PORT=8787
MCP_HOST=127.0.0.1
MCP_SHARED_SECRET=
# Optional comma-separated Host/Origin allowlist for a TLS-authenticated reverse proxy.
# Example: MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.example.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# NAVER WORKS API
NAVER_WORKS_API_BASE=https://www.worksapis.com/v1.0
# Filled by run_naver_works_oauth.bat after a successful user OAuth login.
# Client Secret, authorization code, and refresh token are never written here.
NAVER_WORKS_CLIENT_ID=
NAVER_WORKS_REDIRECT_URI=
NAVER_WORKS_OAUTH_SCOPES=
# The MCP runtime consumes a bearer token. The Windows OAuth helper can perform
# the initial code exchange; refresh and Service Account JWT signing remain external.
NAVER_WORKS_ACCESS_TOKEN=
# Filled only when openid is included in the OAuth response. Never paste this
# value into chat, Git, or Hermes configuration.
NAVER_WORKS_ID_TOKEN=
NAVER_WORKS_AUTH_MODE=user_oauth
NAVER_WORKS_DOMAIN=knocmaint.by-works.net
NAVER_WORKS_USER_ID=
NAVER_WORKS_MOCK=false

# All supported MCP tools are exposed in the initial configuration. The
# Developer Console OAuth Scope is the permission boundary; every state-changing
# call still requires confirm=true. Set either value to false to hide tools.
NAVER_WORKS_WRITE_ENABLED=true
NAVER_WORKS_DELETE_ENABLED=true

# Enforced before a live API call. Keep this equal to the scopes selected in
# Developer Console and issued into the current OAuth token.
NAVER_WORKS_ENFORCE_SCOPES=true
NAVER_WORKS_SCOPES=openid,profile,email,board,board.read,calendar,calendar.read,contact,contact.read,directory.read,form,form.read,group.folder.read,group.note.read,group.read,orgunit.read,security.external-browser,security.external-browser.read,task,task.read,user.email.read,user.profile.read,user.read
